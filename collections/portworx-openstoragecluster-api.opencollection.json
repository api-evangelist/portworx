{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenStorage SDK OpenStorageAlerts OpenStorageCluster API",
    "version": "0.186.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OpenStorageCluster",
        "type": "folder"
      },
      "items": [
